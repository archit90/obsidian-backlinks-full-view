{
  "name": "obsidian-backlinks-full-view",
  "version": "0.1.1",
  "description": "Shows backlinked notes in full, in collapsible sections below the current note.",
  "license": "MIT",
  "author": "Archit Gupta",
  "repository": {
    "type": "git",
    "url": "https://github.com/archit90/obsidian-backlinks-full-view.git"
  },
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node test/smoke.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release": "npm version patch",
    "e2e": "node e2e/run.mjs",
    "e2e:together": "E2E_REQUIRE=dataview,editor-multiple-lanes RESULTS=results-together.md node e2e/run.mjs",
    "sandbox": "e2e/sandbox.sh"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
